{
  "name": "online-hotel-booking",
  "version": "1.0.0",
  "description": "GoBooking – hệ thống đặt phòng khách sạn trực tuyến: giữ phòng có TTL, chống đặt trùng, hàng đợi, thống kê (JavaScript thuần + Webpack)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "webpack serve --mode development --open --config webpack.config.cjs",
    "build": "webpack --mode production --config webpack.config.cjs",
    "test": "node --test",
    "simulate": "node scripts/simulate.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "npm run lint && npm test"
  },
  "dependencies": {
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "css-loader": "^7.1.2",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "html-webpack-plugin": "^5.6.4",
    "style-loader": "^4.0.0",
    "webpack": "^5.101.3",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2"
  },
  "keywords": [
    "hotel-booking",
    "seat-hold",
    "ttl",
    "race-condition",
    "webpack",
    "vanilla-js"
  ]
}
